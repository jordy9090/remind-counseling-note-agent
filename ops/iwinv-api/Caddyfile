{
	# TLS-ALPN validation uses the existing public HTTPS port.
	auto_https disable_redirects
}

api.remind.ai.kr {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	request_body {
		max_size 502MiB
	}
	header Cache-Control no-store
	reverse_proxy 127.0.0.1:8000
}

