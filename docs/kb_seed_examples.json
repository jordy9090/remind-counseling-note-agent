    {
      "slug": "session-note-template-v1",
      "title": "Re:mind session note template checklist",
      "source_org": "Re:mind internal demo",
      "source_type": "session_note",
      "source_url": "https://github.com/jordy9090/remind-counseling-note-agent",
      "effective_date": "2026-07-17",
      "doc_category": "session_note_template",
      "authority_level": "internal_demo",
      "allowed_use": "documentation_structure_only",
      "chunks": [
        {
          "section_path": "session_note > required_fields",
          "document_type": "session_note",
          "chunk_type": "template_fields",
          "chunk_text": "Session notes should separate session metadata, session theme, presenting issue, session content, counselor intervention, client response, important client utterance, nonverbal or paraverbal observation, counselor reflection, and next-session plan. Intervention, response, utterance, and nonverbal information may be combined inside session content when the local form uses a compact format.",
          "allowed_use": "documentation_structure_only",
          "counselor_review_required": false,
          "metadata_json": {
            "required_fields": ["session_metadata", "session_theme", "presenting_problem", "session_content", "counselor_intervention", "client_response", "important_client_utterance", "next_plan"],
            "optional_fields": ["nonverbal_or_paraverbal_observation", "counseling_goal", "psychological_test_summary"],
            "auto_extractable_fields": ["session_theme", "presenting_problem", "session_content", "counselor_intervention", "client_response", "important_client_utterance", "nonverbal_or_paraverbal_observation", "next_plan"],
            "partially_available_fields": ["psychological_test_summary", "counseling_goal"],
            "counselor_review_fields": ["counselor_reflection", "case_conceptualization", "goal_attainment"],
            "missing_field_checklist": ["session_metadata", "risk signal review", "counselor final confirmation"]
          }
        }
      ]
    },
    {
