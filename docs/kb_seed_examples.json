            "required_fields": ["counseling_goals", "counseling_process", "major_interventions"],
            "missing_field_checklist": ["multi-session timeline", "confirmed goals"]
          }
        },
        {
          "source_ref": "kb:termination-report-template-v1:outcomes-unresolved",
          "section_path": "termination_report > outcomes_and_unresolved_issues",
          "document_type": "termination_report",
          "chunk_type": "template_fields",
          "chunk_text": "변화와 성과, 미해결 쟁점은 상담자가 확인한 근거와 함께 적는다. 목표 달성 정도와 종합 의견은 상담자 판단 영역으로 표시한다.",
          "allowed_use": "documentation_structure_only",
          "counselor_review_required": true,
          "metadata_json": {
            "required_fields": ["changes_and_outcomes"],
            "optional_fields": ["unresolved_issues"],
            "counselor_review_fields": ["goal_attainment", "counselor_final_opinion"]
          }
        },
        {
          "source_ref": "kb:termination-report-template-v1:termination-followup",
          "section_path": "termination_report > termination_reason_and_follow_up",
          "document_type": "termination_report",
          "chunk_type": "template_fields",
          "chunk_text": "종결 사유, 추후 계획, 의뢰 또는 사후관리 계획은 상담자가 명확히 확인한 내용으로 작성한다. 확인되지 않은 권고는 누락 항목으로 표시한다.",
          "allowed_use": "documentation_structure_only",
          "counselor_review_required": true,
          "metadata_json": {
            "required_fields": ["termination_reason", "follow_up_plan"],
            "optional_fields": ["referral_plan"],
            "missing_field_checklist": ["termination_reason", "follow_up_plan", "counselor_final_opinion"]
          }
        }
      ]
