# OpenAI (없으면 스텁 모드로 동작)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# USE_STUB=1

# Supabase - 상담 내용 DB 저장 (둘 다 설정해야 DB 저장 모드가 켜짐)
# 미설정 시 기존처럼 로컬 파일에 임시저장됩니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DRAFTS_TABLE=counseling_drafts
ENABLE_PERSISTENCE=0
ENABLE_RAG=0

# Raw counselor memo/transcript storage is off by default.
# Keep this at 0 for demos unless explicit consent, RLS, audit logs, and retention policy are in place.
SAVE_RAW_INPUT=0
