# OpenAI (없으면 스텁 모드로 동작)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# USE_STUB=1

# Supabase - 상담 내용 DB 저장 (둘 다 설정해야 DB 저장 모드가 켜짐)
# 미설정 시 기존처럼 로컬 파일에 임시저장됩니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DRAFTS_TABLE=counseling_drafts
ENABLE_PERSISTENCE=0
ENABLE_RAG=0

# Raw counselor memo/transcript storage is off by default.
# Keep this at 0 for demos unless explicit consent, RLS, audit logs, and retention policy are in place.
SAVE_RAW_INPUT=0

# Upload limits and optional audio transcription.
DOCUMENT_UPLOAD_MAX_BYTES=20971520
DOCX_MAX_ARCHIVE_MEMBERS=2000
DOCX_MAX_UNCOMPRESSED_BYTES=104857600
DOCX_MAX_COMPRESSION_RATIO=100
AUDIO_UPLOAD_MAX_BYTES=524288000
AUDIO_TRANSCRIPTION_STUB=0
ENABLE_AUDIO_TRANSCRIPTION=0
AUDIO_TRANSCRIPTION_ENGINE=whisperx

WHISPERX_MODEL=large-v3
WHISPERX_LANGUAGE=ko
WHISPERX_DEVICE=auto
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_BATCH_SIZE=4
WHISPERX_ALIGN_MODEL=kresnik/wav2vec2-large-xlsr-korean

ENABLE_AUDIO_DIARIZATION=0
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
AUDIO_MAX_DURATION_SECONDS=7200
AUDIO_MAX_CONCURRENT_JOBS=1
