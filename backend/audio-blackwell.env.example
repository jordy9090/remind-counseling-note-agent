# UNQUALIFIED RTX PRO 4000 Blackwell 24 GB acceptance profile; not deployed.
# Operator-owned credentials must be supplied separately. Do not commit a real .env.
# Start disabled; enable only during an explicitly authorized synthetic acceptance run.
ENABLE_AUDIO_TRANSCRIPTION=0
AUDIO_TRANSCRIPTION_STUB=0
AUDIO_TRANSCRIPTION_ENGINE=faster-whisper
AUDIO_MODEL=/models/faster-whisper-large-v3/edaa852ec7e145841d8ffdb056a99866b5f0a478
AUDIO_CAMPPLUS_MODEL=/models/campplus/e4b6ede7ce16997aff4ae69fbca1f0175e2afede
AUDIO_DEVICE=cuda
AUDIO_COMPUTE_TYPE=float16
AUDIO_BEAM_SIZE=1
# Begin with one; qualify four against the retained A100 clip configuration.
AUDIO_BATCH_SIZE=1
AUDIO_WHISPER_VAD_MODE=clips
AUDIO_CPU_THREADS=4
AUDIO_CHUNK_SECONDS=120
AUDIO_CONTEXT_SECONDS=5
AUDIO_MAX_DURATION_SECONDS=3600
AUDIO_DIARIZATION_ENGINE=campplus
AUDIO_UPLOAD_MAX_BYTES=524288000
# Provision this private, quota-limited ephemeral mount before starting the service.
# TMPDIR also covers the framework's multipart spool, not only application files.
UPLOAD_TMP_DIR=/run/remind-audio
TMPDIR=/run/remind-audio
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
AUDIO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# One worker, no reload. Configure verified bearer auth outside this template.
# No automatic GPU unload, shared STT/LLM scheduler, or crash janitor is implemented.
