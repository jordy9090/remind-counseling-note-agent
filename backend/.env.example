# OpenAI API key. Put the real key in backend/.env, never in this example file.
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Optional model name.
OPENAI_MODEL=gpt-4o-mini

# Set to 1 to force stub/sample mode even when an API key exists.
USE_STUB=0

# Optional Supabase persistence / retrieval.
# Use service role key only on the backend. Never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DRAFTS_TABLE=counseling_drafts
ENABLE_PERSISTENCE=0
ENABLE_RAG=0

# Raw counselor memo/transcript storage is off by default.
# Keep this at 0 for demos unless explicit consent, RLS, audit logs, and retention policy are in place.
SAVE_RAW_INPUT=0
