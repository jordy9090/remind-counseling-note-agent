# OpenAI API key. Put the real key in backend/.env, never in this example file.
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Optional model name.
OPENAI_MODEL=gpt-4o-mini

# Set to 1 to force stub/sample mode even when an API key exists.
USE_STUB=0

# Optional Supabase persistence / retrieval.
# Use service role key only on the backend. Never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DRAFTS_TABLE=counseling_drafts
ENABLE_PERSISTENCE=0
ENABLE_RAG=0

# Raw counselor memo/transcript storage is off by default.
# Keep this at 0 for demos unless explicit consent, RLS, audit logs, and retention policy are in place.
SAVE_RAW_INPUT=0

# Upload limits and optional audio transcription.
DOCUMENT_UPLOAD_MAX_BYTES=20971520
DOCX_MAX_ARCHIVE_MEMBERS=2000
DOCX_MAX_UNCOMPRESSED_BYTES=104857600
DOCX_MAX_COMPRESSION_RATIO=100
AUDIO_UPLOAD_MAX_BYTES=524288000
AUDIO_TRANSCRIPTION_STUB=0
ENABLE_AUDIO_TRANSCRIPTION=0
ENABLE_AUDIO_DIARIZATION=0
PYANNOTE_MODEL_NAME=pyannote/speaker-diarization-3.1
HF_TOKEN=
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
