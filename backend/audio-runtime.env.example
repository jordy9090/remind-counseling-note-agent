# Self-hosted only. Never put credentials in this file or in the frontend build.
ENABLE_AUDIO_TRANSCRIPTION=1
AUDIO_TRANSCRIPTION_STUB=0
AUDIO_TRANSCRIPTION_ENGINE=faster-whisper
AUDIO_MODEL=large-v3
AUDIO_DEVICE=cuda
AUDIO_COMPUTE_TYPE=float16
AUDIO_BEAM_SIZE=1
AUDIO_BATCH_SIZE=4
AUDIO_WHISPER_VAD_MODE=clips
AUDIO_CPU_THREADS=4
AUDIO_CHUNK_SECONDS=120
AUDIO_CONTEXT_SECONDS=5
AUDIO_MAX_DURATION_SECONDS=3600
AUDIO_DIARIZATION_ENGINE=campplus
# Use immutable downloaded directories for offline production operation.
# AUDIO_MODEL=/models/faster-whisper-large-v3/edaa852ec7e145841d8ffdb056a99866b5f0a478
# AUDIO_CAMPPLUS_MODEL=/models/campplus/<revision>
# AUDIO_FSMN_MODEL=/models/fsmn-vad/<revision>
# HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# Dedicated ephemeral directory owned by the service account; provision it first.
# UPLOAD_TMP_DIR=/run/remind-audio
AUDIO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Authentication uses the existing verified-user configuration. Do not enable a
# local bypass for a network-facing service. Run one Uvicorn worker without reload.
