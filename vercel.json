{
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/notes/records/:note_id",
      "destination": "/api/notes/record?note_id=:note_id"
    },
    {
      "source": "/api/notes/drafts/:draft_id",
      "destination": "/api/notes/draft?draft_id=:draft_id"
    },
    {
      "source": "/api/cases",
      "destination": "/api/cases/dashboard?scope=list"
    },
    {
      "source": "/api/cases/:case_id/dashboard",
      "destination": "/api/cases/dashboard?case_id=:case_id"
    },
    {
      "source": "/api/cases/:case_id/schedule",
      "destination": "/api/cases/dashboard?case_id=:case_id&scope=schedule"
    },
    {
      "source": "/api/cases/:case_id/profile",
      "destination": "/api/cases/dashboard?case_id=:case_id&scope=profile"
    }
  ],
  "functions": {
    "api/materials/documents/extract.py": {
      "maxDuration": 60
    }
  }
}
